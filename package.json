{
  "name": "titipo-web",
  "version": "0.1.0",
  "private": true,
  "description": "TitipO Web Admin — Bun + Svelte + TS",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:pact": "vitest run tests/pact",
    "gen:api": "openapi-typescript contract/openapi.yaml -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^17.1.4",
    "@sveltejs/adapter-node": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^26.6.5",
    "openapi-typescript": "^7.13.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "bun": ">=1.4.0 <1.5.0"
  }
}
